{
  "name": "staple/staple-code",
  "description": "A PHP 7 MVC framework for rapid application development",
  "authors": [
    {
      "name": "Scott Henscheid"
    },
    {
      "name": "Hans Heeling"
    },
    {
      "name": "Adam Day"
    }
  ],
  "require": {
    "php": ">=8.2",
    "ext-pdo": "*",
    "ext-json": "*",
    "ext-openssl": "*",
    "twig/twig":"~v3.21.1",
    "phpunit/phpunit": "^11.5.36",
    "predis/predis":"^v3.2.0",
    "auth0/auth0-php": "^7.4",
    "ext-ldap": "*",
    "vlucas/phpdotenv": "^5.6"
  },
  "suggest": {
    "ext-ctype": "Provide ctype function support for installs without the ctype extension."
  },
  "autoload": {
    "psr-0": {
      "Staple": "library/"
    }
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": false
    }
  }
}
